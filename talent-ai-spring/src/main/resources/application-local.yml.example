# =====================================================================
#  本地私有配置模板
#
#  用法：
#    cp application-local.yml.example application-local.yml
#  然后把下面的占位值替换成你自己的真实值。
#  application-local.yml 已在 .gitignore 中，不会被提交。
#
#  也可以完全不创建这个文件，直接设置同名环境变量：
#    DEEPSEEK_API_KEY / MYSQL_USERNAME / MYSQL_PASSWORD
#    MINIO_ACCESS_KEY / MINIO_SECRET_KEY
# =====================================================================

spring:
  ai:
    openai:
      api-key: ${DEEPSEEK_API_KEY:在这里填你的 DeepSeek API Key}
  datasource:
    username: ${MYSQL_USERNAME:root}
    password: ${MYSQL_PASSWORD:在这里填你的 MySQL 密码}

minio:
  accessKey: ${MINIO_ACCESS_KEY:在这里填你的 MinIO AccessKey}
  secretKey: ${MINIO_SECRET_KEY:在这里填你的 MinIO SecretKey}
